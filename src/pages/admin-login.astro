---
// Admin login page - password protected entry to admin panel
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DWan博客 - 后台登录</title>
  </head>
  <body>
    <div class="login-page">
      <div class="login-box">
        <h1>DWan博客 - 后台管理</h1>
        <p class="subtitle">请输入密码以访问管理面板</p>
        <input type="password" id="admin-password" placeholder="密码" />
        <p class="error" id="login-error"></p>
        <button id="login-btn">登录</button>
        <p class="hint">首次使用请设置密码</p>
      </div>
    </div>
  </body>
</html>

<style>
  .login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg, #f8fafc); }
  .login-box { background: var(--card-bg, #fff); border-radius: 16px; padding: 40px; box-shadow: 0 4px 24px rgba(0,0,0,0.1); width: 360px; text-align: center; }
  .login-box h1 { margin: 0 0 8px; font-size: 1.5rem; }
  .subtitle { color: var(--text-secondary, #6b7280); margin: 0 0 24px; font-size: 0.9rem; }
  input { width: 100%; padding: 12px 16px; border: 1px solid var(--border, #e5e7eb); border-radius: 8px; margin-bottom: 12px; font-size: 1rem; background: var(--input-bg, #f9fafb); color: var(--text-main); }
  button { width: 100%; padding: 12px; background: var(--primary, #6366f1); color: #fff; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer; }
  .error { color: #dc2626; font-size: 0.85rem; margin-bottom: 12px; min-height: 1.2em; }
  .hint { color: var(--text-muted, #9ca3af); font-size: 0.8rem; margin-top: 16px; }
</style>

<script>
  const btn = document.getElementById('login-btn');
  const input = document.getElementById('admin-password');
  const errEl = document.getElementById('login-error');
  const encodePassword = (value: string) => Array.from(new TextEncoder().encode(value), (byte) => byte.toString(16).padStart(2, '0')).join('');
  const startSession = () => sessionStorage.setItem('dw_admin_session', String(Date.now() + 8 * 60 * 60 * 1000));
  if (!(btn instanceof HTMLButtonElement) || !(input instanceof HTMLInputElement) || !errEl) {
    throw new Error('后台登录表单初始化失败');
  }
  btn.addEventListener('click', () => {
    const pw = input.value;
    if (!pw) { errEl.textContent = '请输入密码'; return; }
    const encoded = encodePassword(pw);
    const stored = localStorage.getItem('dw_admin_password');
    if (!stored) {
      localStorage.setItem('dw_admin_password', encoded);
      startSession();
      window.location.href = "/admin";
    } else if (encoded === stored) {
      startSession();
      window.location.href = "/admin";
    } else {
      errEl.textContent = '密码错误';
    }
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') btn.click();
  });
</script>