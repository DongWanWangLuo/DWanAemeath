---
// Admin dashboard page - password protected
---
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DWan博客 - 后台管理</title>
</head>

<div class="admin-page">
  <div class="admin-container">
    <div class="admin-sidebar">
      <h2>后台管理</h2>
      <nav class="admin-nav">
        <a href="#appearance" class="nav-item active" data-tab="appearance">外观设置</a>
        <a href="#wallpaper" class="nav-item" data-tab="wallpaper">壁纸管理</a>
        <a href="#effects" class="nav-item" data-tab="effects">特效控制</a>
        <a href="#settings" class="nav-item" data-tab="settings">网站设置</a>
        <a href="#posts" class="nav-item" data-tab="posts">文章管理</a>
        <a href="#sync" class="nav-item" data-tab="sync">数据同步</a>
      </nav>
      <div class="admin-footer">
        <button id="logout-btn" class="logout-btn">退出登录</button>
        <a href="/" class="back-link">返回网站</a>
      </div>
    </div>
    <div class="admin-main">
      <div id="tab-appearance" class="tab-content active">
        <h3>外观设置</h3>
        <div class="setting-group">
          <label class="setting-label">主题色相</label>
          <input type="range" id="hue-slider" min="0" max="360" value="240" />
          <span id="hue-value">240</span>
        </div>
        <div class="setting-group">
          <label class="setting-label">亮/暗色模式</label>
          <select id="theme-select">
            <option value="light">浅色</option>
            <option value="dark">深色</option>
            <option value="system">跟随系统</option>
          </select>
        </div>
      </div>
      <div id="tab-wallpaper" class="tab-content">
        <h3>壁纸管理</h3>
        <div class="setting-group">
          <label class="setting-label">壁纸模式</label>
          <select id="wallpaper-mode">
            <option value="banner">横幅壁纸</option>
            <option value="fullscreen" selected>全屏壁纸</option>
            <option value="overlay">透明覆盖</option>
            <option value="none">纯色背景</option>
          </select>
        </div>
      </div>
      <div id="tab-effects" class="tab-content">
        <h3>特效控制</h3>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="sakura-toggle" /> 樱花特效</label></div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="waves-toggle" /> 水波纹动画</label></div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="gradient-toggle" /> 渐变过渡</label></div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="banner-title-toggle" /> 首页横幅标题</label></div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="carousel-toggle" /> 壁纸轮播</label></div>
      </div>
      <div id="tab-settings" class="tab-content">
        <h3>网站设置</h3>
        <div class="setting-group">
          <label class="setting-label">文章布局</label>
          <select id="post-layout">
            <option value="list">列表模式</option>
            <option value="grid" selected>网格模式</option>
          </select>
        </div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="category-bar-toggle" checked /> 分类导航栏</label></div>
        <div class="setting-group"><label class="setting-label"><input type="checkbox" id="show-tags-toggle" checked /> 文章列表显示标签</label></div>
      </div>
      <div id="tab-posts" class="tab-content">
        <h3>文章管理</h3>
        <p>文章内容存储在 <code>src/content/posts/</code> 目录下。</p>
        <p style="color:#888;font-size:0.85rem">通过 GitHub 同步后，可直接编辑本地 Markdown 文件后提交变更。</p>
        <p style="margin-top:16px"><strong>待开发：</strong>富文本编辑器集成（Vditor）</p>
      </div>
      <div id="tab-sync" class="tab-content">
        <h3>数据同步</h3>
        <p style="color:#888;font-size:0.85rem;margin-bottom:16px">点击下方按钮，自动将当前所有设置推送到 GitHub 仓库的 <code>src/data/admin-config.json</code>。</p>
        <div class="setting-group">
          <label class="setting-label">GitHub Token</label>
          <input type="text" id="github-token" placeholder="ghp_xxxxxxxxxxxx" />
        </div>
        <div class="setting-group">
          <label class="setting-label">仓库名</label>
          <input type="text" id="github-repo" placeholder="DongWanWangLuo/DWanAemeath" />
        </div>
        <button id="sync-btn" class="sync-btn">保存并同步到 GitHub</button>
        <p id="sync-status" style="margin-top:12px;color:#888;font-size:0.85rem"></p>
      </div>
    </div><!-- /admin-main -->
  </div><!-- /admin-container -->
</div><!-- /admin-page -->

<style>
  .admin-page { min-height: 100vh; background: var(--bg, #f8fafc); }
  .admin-container { display: flex; min-height: 100vh; }
  .admin-sidebar { width: 240px; background: var(--card-bg, #fff); border-right: 1px solid var(--border, #e5e7eb); display: flex; flex-direction: column; position: fixed; left: 0; top: 0; height: 100vh; overflow-y: auto; }
  .admin-sidebar h2 { margin: 0; padding: 20px; font-size: 1.2rem; border-bottom: 1px solid var(--border, #e5e7eb); color: var(--text-main, #1a1a1a); }
  .admin-nav { flex: 1; padding: 12px; }
  .nav-item { display: block; padding: 10px 12px; border-radius: 8px; color: var(--text-secondary, #6b7280); text-decoration: none; font-size: 0.9rem; margin-bottom: 4px; cursor: pointer; }
  .nav-item:hover { background: var(--bg, #f8fafc); color: var(--text-main, #1a1a1a); }
  .nav-item.active { background: var(--primary, #6366f1); color: #fff; }
  .admin-footer { padding: 16px; border-top: 1px solid var(--border, #e5e7eb); }
  .logout-btn { width: 100%; padding: 8px; background: transparent; border: 1px solid var(--border, #e5e7eb); border-radius: 6px; cursor: pointer; color: var(--text-secondary, #6b7280); font-size: 0.85rem; margin-bottom: 8px; }
  .logout-btn:hover { background: #fef2f2; border-color: #fecaca; color: #dc2626; }
  .back-link { display: block; text-align: center; font-size: 0.85rem; color: var(--text-muted, #9ca3af); text-decoration: none; }
  .back-link:hover { color: var(--primary, #6366f1); }
  .admin-main { margin-left: 240px; flex: 1; padding: 32px 40px; max-width: 900px; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .tab-content h3 { margin: 0 0 24px; font-size: 1.1rem; color: var(--text-main, #1a1a1a); }
  .setting-group { margin-bottom: 20px; }
  .setting-label { display: block; font-size: 0.85rem; color: var(--text-muted, #9ca3af); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; font-weight: 600; }
  .setting-label input[type="checkbox"] { margin-right: 8px; }
  input[type="range"] { width: 100%; accent-color: var(--primary, #6366f1); }
  select, input[type="text"] { width: 100%; padding: 10px 12px; border: 1px solid var(--border, #e5e7eb); border-radius: 8px; background: var(--input-bg, #f9fafb); color: var(--text-main, #1a1a1a); font-size: 0.95rem; box-sizing: border-box; }
  .sync-btn { padding: 12px 24px; background: var(--primary, #6366f1); color: #fff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.95rem; margin-top: 8px; }
  .sync-btn:hover { opacity: 0.9; }
  .sync-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  code { background: var(--bg, #f8fafc); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  @media (max-width: 768px) { .admin-sidebar { width: 200px; } .admin-main { margin-left: 200px; padding: 20px; } }
</style>
<script>
  // Check login
  if (sessionStorage.getItem("dw_admin_session") !== "1") { window.location.href = "/admin-login"; }

  // Tab navigation
  document.querySelectorAll(".nav-item").forEach(function(item) {
    item.addEventListener("click", function(e) {
      e.preventDefault();
      document.querySelectorAll(".nav-item").forEach(function(i) { i.classList.remove("active"); });
      document.querySelectorAll(".tab-content").forEach(function(c) { c.classList.remove("active"); });
      this.classList.add("active");
      document.getElementById("tab-" + this.dataset.tab).classList.add("active");
    });
  });

  // Hue slider
  var hueSlider = document.getElementById("hue-slider");
  var hueValue = document.getElementById("hue-value");
  hueSlider.addEventListener("input", function() {
    var v = this.value;
    hueValue.textContent = v;
    document.querySelector(":root").style.setProperty("--hue", v);
    localStorage.setItem("dw_admin_hue", v);
  });

  // Theme select
  document.getElementById("theme-select").addEventListener("change", function() {
    var t = this.value;
    localStorage.setItem("dw_admin_theme", t);
    document.documentElement.setAttribute("data-theme", t);
    window.dispatchEvent(new CustomEvent("dw_theme_change", { detail: { theme: t } }));
  });

  // Wallpaper mode
  document.getElementById("wallpaper-mode").addEventListener("change", function() {
    var m = this.value;
    localStorage.setItem("dw_admin_wallpaper_mode", m);
    window.dispatchEvent(new CustomEvent("dw_wallpaper_mode_change", { detail: { mode: m } }));
  });

  // Effect toggles
  var effectToggles = {
    "sakura-toggle": { key: "dw_admin_sakura", event: "dw_sakura_toggle" },
    "waves-toggle": { key: "dw_admin_waves", event: "dw_waves_toggle" },
    "gradient-toggle": { key: "dw_admin_gradient", event: "dw_gradient_toggle" },
    "banner-title-toggle": { key: "dw_admin_banner_title", event: "dw_banner_title_toggle" },
    "carousel-toggle": { key: "dw_admin_carousel", event: "dw_carousel_toggle" }
  };
  Object.keys(effectToggles).forEach(function(id) {
    var cfg = effectToggles[id];
    var el = document.getElementById(id);
    if (!el) return;
    if (localStorage.getItem(cfg.key) === "true") el.checked = true;
    el.addEventListener("change", function() {
      localStorage.setItem(cfg.key, this.checked);
      window.dispatchEvent(new CustomEvent(cfg.event, { detail: { enabled: this.checked } }));
    });
  });

  // Setting toggles
  var settingToggles = {
    "category-bar-toggle": { key: "dw_admin_category_bar", type: "checkbox" },
    "show-tags-toggle": { key: "dw_admin_show_tags", type: "checkbox" },
    "post-layout": { key: "dw_admin_post_layout", type: "select" }
  };
  Object.keys(settingToggles).forEach(function(id) {
    var cfg = settingToggles[id];
    var el = document.getElementById(id);
    if (!el) return;
    var saved = localStorage.getItem(cfg.key);
    if (saved !== null) {
      if (cfg.type === "checkbox") el.checked = saved === "true";
      else el.value = saved;
    }
    el.addEventListener("change", function() {
      localStorage.setItem(cfg.key, cfg.type === "checkbox" ? this.checked : this.value);
    });
  });

  // Sync button
  document.getElementById("sync-btn").addEventListener("click", async function() {
    var btn = this;
    var status = document.getElementById("sync-status");
    var token = document.getElementById("github-token").value;
    var repo = document.getElementById("github-repo").value;
    if (!token || !repo) { alert("请先填写 GitHub Token 和仓库名"); return; }
    localStorage.setItem("dw_admin_github_token", token);
    localStorage.setItem("dw_admin_github_repo", repo);
    btn.disabled = true;
    btn.textContent = "同步中...";
    status.textContent = "正在推送配置到 GitHub...";
    status.style.color = "#888";
    try {
      var keys = [];
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i);
        if (k && k.indexOf("dw_admin_") === 0 && k !== "dw_admin_github_token" && k !== "dw_admin_github_repo") {
          keys.push({ key: k, value: localStorage.getItem(k) });
        }
      }
      var config = {};
      keys.forEach(function(item) { config[item.key] = item.value; });
      var res = await fetch("/api/sync", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token: token, repo: repo, config: config })
      });
      var result = await res.json();
      if (result.ok) {
        status.textContent = "同步成功！配置已推送到 GitHub。";
        status.style.color = "#16a34a";
      } else {
        status.textContent = "同步失败: " + (result.error || "未知错误");
        status.style.color = "#dc2626";
      }
    } catch (e) {
      status.textContent = "请求失败: " + e.message;
      status.style.color = "#dc2626";
    } finally {
      btn.disabled = false;
      btn.textContent = "保存并同步到 GitHub";
    }
  });

  // Load settings on init
  (function loadSettings() {
    var hue = localStorage.getItem("dw_admin_hue");
    if (hue) { hueSlider.value = hue; hueValue.textContent = hue; document.querySelector(":root").style.setProperty("--hue", hue); }
    var theme = localStorage.getItem("dw_admin_theme");
    if (theme) { document.getElementById("theme-select").value = theme; document.documentElement.setAttribute("data-theme", theme); }
    var wallpaperModeVal = localStorage.getItem("dw_admin_wallpaper_mode");
    if (wallpaperModeVal) document.getElementById("wallpaper-mode").value = wallpaperModeVal;
    Object.keys(effectToggles).forEach(function(id) {
      var cfg = effectToggles[id];
      var el = document.getElementById(id);
      if (el) el.checked = localStorage.getItem(cfg.key) === "true";
    });
    Object.keys(settingToggles).forEach(function(id) {
      var cfg = settingToggles[id];
      var el = document.getElementById(id);
      if (!el) return;
      var saved = localStorage.getItem(cfg.key);
      if (saved !== null) {
        if (cfg.type === "checkbox") el.checked = saved === "true";
        else el.value = saved;
      }
    });
    var stoken = localStorage.getItem("dw_admin_github_token");
    if (stoken) document.getElementById("github-token").value = stoken;
    var srepo = localStorage.getItem("dw_admin_github_repo");
    if (srepo) document.getElementById("github-repo").value = srepo;
  })();

  // Logout
  document.getElementById("logout-btn").addEventListener("click", function() {
    sessionStorage.removeItem("dw_admin_session");
    window.location.href = "/";
  });
</script>